{
  "name": "bunty-biryani-centre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "pnpm run \"/^dev:/\"",
    "dev:server": "tsx watch --env-file=.env src/server/index.ts --no-client",
    "dev:client": "vite",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "prisma generate && tsc -p tsconfig.server.json",
    "start": "node dist/node/src/server/index.js",
    "start:local": "node --env-file=.env dist/node/src/server/index.js",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed-dev.ts",
    "db:seed:initial": "node dist/node/prisma/seed-initial.js",
    "admin:create": "tsx --env-file=.env scripts/admin-create.ts",
    "admin:create:prod": "node dist/node/scripts/admin-create.js",
    "admin:reset-password": "tsx --env-file=.env scripts/admin-reset-password.ts",
    "admin:reset-password:prod": "node dist/node/scripts/admin-reset-password.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "copy:print": "tsx scripts/print-copy.ts",
    "smoke:test": "tsx scripts/smoke-test.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "swr": "2.5.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
